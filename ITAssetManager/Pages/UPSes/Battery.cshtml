@page
@model ITAssetManager.Pages.UPSes.BatteryModel
@using ITAssetManager.Convertor


@{
}
@{
    ViewData["Title"] = "مدیریت مصرف باتری ها";
}

<div class="container-fluid">

    @if (TempData["BatterySuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["BatterySuccess"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <!-- عنوان صفحه -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">
                <i class="bi bi-lightning-charge me-2"></i>
                مدیریت مصرف باتری
            </h4>

            <small class="text-muted">
                ثبت و مشاهده سابقه مصرف باتری UPS
            </small>
        </div>

        <a asp-page="/UPSes/Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-right me-1"></i>
            بازگشت
        </a>
    </div>

    <!-- مشخصات یو پی اس -->
    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <i class="bi bi-plug me-2"></i>
            مشخصات UPS
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4 mb-3">
                    <div class="text-muted small">
                        نام تجهیز
                    </div>

                    <div class="fw-bold">
                        @Model.UPS.Name
                    </div>
                </div>


                <div class="col-md-4 mb-3">
                    <div class="text-muted small">
                        شماره اموال
                    </div>

                    <div class="fw-bold">
                        @Model.UPS.PropertyTag
                    </div>
                </div>


                <div class="col-md-4 mb-3">
                    <div class="text-muted small">
                        سریال
                    </div>

                    <div class="fw-bold">
                        @Model.UPS.SerialNumber
                    </div>
                </div>


                <div class="col-md-4">
                    <div class="text-muted small">
                        وضعیت
                    </div>

                    <div class="fw-bold">
                        @Model.UPS.Status.GetDisplayName()
                    </div>
                </div>


                <div class="col-md-4">
                    <div class="text-muted small">
                        تحویل گیرنده
                    </div>

                    <div class="fw-bold">
                        @Model.UPS.EmployeeName
                    </div>
                </div>


                <div class="col-md-4">
                    <div class="text-muted small">
                        واحد
                    </div>

                    <div class="fw-bold">
                        @Model.UPS.DepartmentName
                    </div>
                </div>

            </div>

        </div>
    </div>

    <!-- ثبت مصرف باتری -->
    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <i class="bi bi-plus-circle me-2"></i>
            ثبت مصرف باتری
        </div>

        <div class="card-body">

            <form method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row">

                    <!-- باتری -->
                    <div class="col-md-4 mb-3">

                        <label asp-for="ProductId"
                               class="form-label">
                            باتری
                        </label>

                        <select asp-for="ProductId"
                                class="form-select">

                            <option value="">
                                انتخاب باتری...
                            </option>

                            @foreach (var product in Model.BatteryProduct)
                            {
                                <option value="@product.ProductId">
                                    @product.ProductName - موجودی: @product.Quantity
                                </option>
                            }

                        </select>

                        <span asp-validation-for="ProductId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- تعداد -->
                    <div class="col-md-2 mb-3">

                        <label asp-for="Quantity"
                               class="form-label">
                            تعداد
                        </label>

                        <input asp-for="Quantity"
                               type="number"
                               min="1"
                               class="form-control" />

                        <span asp-validation-for="Quantity"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- تاریخ مصرف -->
                    <div class="col-md-3 mb-3">

                        <label asp-for="ConsumptionShamsiDate"
                               class="form-label">
                            تاریخ مصرف
                        </label>

                        <input asp-for="ConsumptionShamsiDate"
                               class="form-control"
                               placeholder="1405/01/01"
                               autocomplete="off" />

                        <span asp-validation-for="ConsumptionShamsiDate"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- توضیحات -->
                    <div class="col-md-3 mb-3">

                        <label asp-for="Description"
                               class="form-label">
                            توضیحات
                        </label>

                        <input asp-for="Description"
                               class="form-control"
                               placeholder="اختیاری" />

                    </div>

                </div>


                <div class="d-flex justify-content-end">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check2-circle me-1"></i>

                        ثبت مصرف

                    </button>

                </div>

            </form>

        </div>

    </div>

    <!-- سابقه مصرف -->
    <div class="card shadow-sm">

        <div class="card-header d-flex justify-content-between align-items-center">

            <span>
                <i class="bi bi-clock-history me-2"></i>
                سابقه مصرف باتری
            </span>

            <span class="badge bg-secondary">
                @Model.Consumptions.Count مورد
            </span>

        </div>


        <div class="card-body p-0">

            @if (Model.Consumptions.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover table-striped mb-0">

                        <thead>
                            <tr>
                                <th>ردیف</th>
                                <th>باتری</th>
                                <th>تعداد</th>
                                <th>تاریخ مصرف</th>
                                <th>ثبت کننده</th>
                                <th>توضیحات</th>
                            </tr>
                        </thead>

                        <tbody>

                            @{
                                int row = 1;
                            }

                            @foreach (var item in Model.Consumptions)
                            {
                                <tr>

                                    <td>
                                        @row
                                    </td>

                                    <td>
                                        @item.Product?.ProductName
                                    </td>

                                    <td>
                                        @item.Quantity
                                    </td>

                                    <td>
                                        @item.ConsumptionDate.ToShamsi()
                                    </td>

                                    <td>
                                        @item.CreatedBy
                                    </td>

                                    <td>
                                        @item.Description
                                    </td>

                                </tr>

                                row++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center text-muted py-5">

                    <i class="bi bi-inbox fs-1 d-block mb-3"></i>

                    <div>
                        تاکنون مصرف باتری برای این UPS ثبت نشده است.
                    </div>

                </div>
            }

        </div>

    </div>

</div>