@page
@using ITAssetManager.Convertor
@model ITAssetManager.Pages.WarehouseManagements.WarehouseTransfers.IndexModel

@{
	ViewData["Title"] = "لیست انتقال ها";
}

<div class="d-flex justify-content-between align-items-center mb-3">
	<a asp-page="Create" class="btn btn-primary btn-sm">
		<i class="bi bi-plus-lg me-1"></i>ثبت انتقال جدید
	</a>
</div>

<!-- Filters -->
<div class="card mb-3">
	<div class="card-body py-2">
		<form method="get" class="row g-2 align-items-end">
			<div class="col-md-2">
				<input type="number" name="ReceiptNumber" value="@Model.TransferNumber"
					   class="form-control form-control-sm search-box"
					   placeholder="جستجو در شماره انتقال..." />
			</div>


			<div class="col-md-2">
				<select name="WarehouseId" class="form-select form-select-sm">
					<option value="">همه انبارها</option>
					@foreach (var warehouse in Model.WarehouseList)
					{
						<option value="@warehouse.Id" selected="@(Model.WarehouseId == warehouse.Id)">@warehouse.WarehouseName</option>
					}
				</select>
			</div>
			<div class="col-md-2">
				<select name="status" class="form-select form-select-sm">
					<option value="">همه وضعیت‌ها</option>
					<option value="1" selected="@(Model.Status == 1)">پیش‌ نویس</option>
					<option value="2" selected="@(Model.Status == 2)">نهایی شده</option>
					<option value="3" selected="@(Model.Status == 3)">ابطال شده</option>

				</select>
			</div>

			<div class="col-md-2 d-flex gap-1">
				<button type="submit" class="btn btn-primary btn-sm flex-fill">
					<i class="bi bi-search"></i> جستجو
				</button>
				<a asp-page="./Index" class="btn btn-outline-secondary btn-sm">
					<i class="bi bi-x"></i>
				</a>
			</div>
		</form>
	</div>
</div>


<table class="table">
	<thead>
		<tr>
			<th>
				@Html.DisplayNameFor(model => model.WarehouseTransfer[0].TransferNumber)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.WarehouseTransfer[0].SourceWarehouse)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.WarehouseTransfer[0].DestinationWarehouse)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.WarehouseTransfer[0].TransferDate)
			</th>

			<th>
				@Html.DisplayNameFor(model => model.WarehouseTransfer[0].Description)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.WarehouseTransfer[0].CreatedBy)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.WarehouseTransfer[0].CreatedAt)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.WarehouseTransfer[0].Status)
			</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model.WarehouseTransfer)
		{
			<tr>
				<td>
					@Html.DisplayFor(modelItem => item.TransferNumber)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.SourceWarehouse.WarehouseName)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.DestinationWarehouse.WarehouseName)
				</td>
				<td>
					@item.TransferDate.ToShamsi()
				</td>

				<td>
					@Html.DisplayFor(modelItem => item.Description)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.CreatedBy)
				</td>
				<td>
					@item.CreatedAt.ToShamsi()
				</td>
				<td>
					@if (item.Status == DocumentStatus.Draft)
					{
						<span class="badge bg-warning">
							پیش نویس
						</span>
					}
					@if (item.Status == DocumentStatus.Posted)
					{
						<span class="badge bg-success">
							نهایی شده
						</span>
					}
					@if (item.Status == DocumentStatus.Cancelled)
					{
						<span class="badge bg-danger">
							ابطال شده
						</span>
					}
				</td>
				<td>
					<div class="d-flex gap-1">
						<a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-xs btn-outline-secondary" title="مشاهده انتقال">
							<i class="bi bi-file-earmark-text"></i>
						</a>
					</div>
				</td>
			</tr>
		}
	</tbody>
</table>
