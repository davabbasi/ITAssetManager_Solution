@page
@model ITAssetManager.Pages.WarehouseManagements.WarehouseTransfers.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.WarehouseTransfer[0].TransferNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WarehouseTransfer[0].SourceWarehouse)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WarehouseTransfer[0].DestinationWarehouse)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WarehouseTransfer[0].TransferDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WarehouseTransfer[0].Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WarehouseTransfer[0].Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WarehouseTransfer[0].CreatedBy)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WarehouseTransfer[0].CreatedAt)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.WarehouseTransfer) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.TransferNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SourceWarehouse.WarehouseName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DestinationWarehouse.WarehouseName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TransferDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedBy)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedAt)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
