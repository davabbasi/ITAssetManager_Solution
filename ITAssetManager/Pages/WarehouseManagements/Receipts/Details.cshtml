@page
@model ITAssetManager.Pages.WarehouseManagements.Receipts.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>
<div class="card mb-3">

    <div class="card-header">

        اطلاعات رسید

    </div>

    <div class="card-body">

        <div class="row">

            <div class="col-md-3">

                <strong>شماره رسید</strong>

                <br />

                @Model.WarehouseReceipt.ReceiptNumber

            </div>

            <div class="col-md-3">

                <strong>تاریخ</strong>

                <br />

                @Model.WarehouseReceipt.ReceiptDate

            </div>

            <div class="col-md-3">

                <strong>انبار</strong>

                <br />

                @Model.WarehouseReceipt.Warehouse?.WarehouseName

            </div>

            <div class="col-md-3">

                <strong>انباردار</strong>

                <br />

                @Model.WarehouseReceipt.Warehouse.KeeperEmployeeFullName

            </div>

        </div>

        <hr />

        <div class="row">

            <div class="col-md-4">

                <strong>شماره درخواست خرید</strong>

                <br />

                @Model.WarehouseReceipt.ReferenceNumber

            </div>

            <div class="col-md-8">

                <strong>توضیحات</strong>

                <br />

                @Model.WarehouseReceipt.Description

            </div>

        </div>

    </div>

</div>


<div class="card">

    <div class="card-header">

        اقلام رسید

    </div>

    <div class="card-body p-0">

        <table class="table table-bordered mb-0">

            <thead>

                <tr>

                    <th>#</th>

                    <th>کالا</th>

                    <th>تعداد</th>

                </tr>

            </thead>

            <tbody>

                @{
                    int row = 1;
                }

                @foreach (var item in Model.WarehouseReceipt.Items)
                {
                    <tr>

                        <td>@row</td>

                        <td>@item.Product?.ProductName</td>

                        <td>@item.Quantity</td>

                    </tr>

                    row++;
                }

            </tbody>

        </table>

    </div>

</div>




