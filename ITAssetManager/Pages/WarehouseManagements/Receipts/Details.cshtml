@page
@model ITAssetManager.Pages.WarehouseManagements.Receipts.DetailsModel
@using ITAssetManager.Convertor
@{
    ViewData["Title"] = "جزئیات رسید";
}

<div class="card mb-3">

    <div class="card-header">اطلاعات رسید</div>

    <div class="card-body">
        <div class="row">

            <div class="col-md-3">
                <strong>شماره رسید</strong>
                <br />
                @Model.WarehouseReceipt.ReceiptNumber
            </div>

            <div class="col-md-3">
                <strong>تاریخ</strong>
                <br />
                @Model.ShamsiDate
            </div>
            <div class="col-md-3">
                <strong>انبار</strong>
               <br />
                @Model.WarehouseReceipt.Warehouse?.WarehouseName
            </div>
            <div class="col-md-3">
                <strong>انباردار</strong>
                <br />
                @Model.WarehouseReceipt.Warehouse.Keeper.FullName
            </div>
            <div class="col-md-3">
                <strong>وضعیت رسید</strong>
                <br />
                @if (Model.WarehouseReceipt.Status == DocumentStatus.Posted)
                {
                    <span class="badge bg-success">
                        نهایی شده
                    </span>
                }
                @if (Model.WarehouseReceipt.Status == DocumentStatus.Draft)
                {
                    <span class="badge bg-warning">
                        پیش نویس
                    </span>
                }
                @if (Model.WarehouseReceipt.Status == DocumentStatus.Cancelled)
                {
                    <span class="badge bg-danger">
                        ابطال شده
                    </span>
                }
            </div>
        </div>

        <hr />

        <div class="row">

            <div class="col-md-4">

                <strong>شماره درخواست خرید</strong>

                <br />

                @Model.WarehouseReceipt.ReferenceNumber

            </div>

            <div class="col-md-8">

                <strong>توضیحات</strong>

                <br />

                @Model.WarehouseReceipt.Description

            </div>

        </div>

    </div>

</div>


<div class="card">

    <div class="card-header">

        اقلام رسید

    </div>

    <div class="card-body p-0">

        <table class="table table-bordered mb-0">

            <thead>

                <tr>

                    <th>#</th>

                    <th>کالا</th>

                    <th>تعداد</th>

                </tr>

            </thead>

            <tbody>

                @{
                    int row = 1;
                }

                @foreach (var item in Model.WarehouseReceipt.Items)
                {
                    <tr>

                        <td>@row</td>

                        <td>@item.Product?.ProductName</td>

                        <td>@item.Quantity</td>

                    </tr>

                    row++;
                }

            </tbody>

        </table>

    </div>

</div>


@if (Model.WarehouseReceipt.Status == DocumentStatus.Draft)
{
    <br />
    <a asp-page="./Edit"
       asp-route-id="@Model.WarehouseReceipt.Id"
       class="btn btn-warning">
        ویرایش
    </a>

    <form method="post"
          asp-page-handler="Post"
          asp-route-id="@Model.WarehouseReceipt.Id"
          style="display:inline">

        <button type="submit"
                class="btn btn-success"
                onclick="return confirm('آیا از ثبت نهایی این رسید اطمینان دارید؟');">

            ثبت نهایی

        </button>
        <br />
    </form>
}

@if (Model.WarehouseReceipt.Status == DocumentStatus.Posted)
{
    <form method="post"
          asp-page-handler="Cancel"
          asp-route-id="@Model.WarehouseReceipt.Id"
          class="d-inline">
        <br />
        <button type="submit"
                class="btn btn-danger"
                onclick="return confirm('آیا از ابطال این رسید اطمینان دارید؟');">

            <i class="bi bi-x-circle"></i>
            ابطال رسید

        </button>
        <br />

    </form>
}
<br />
<div>
    <a asp-page="./Index" class="btn btn-secondary">
        بازگشت به لیست
    </a>
</div>
