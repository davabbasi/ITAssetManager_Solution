@page "{id:int}"
@model ITAssetManager.Pages.WarehouseManagements.Receipts.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>WarehouseReceipt</h4>
<hr />




<div class="card">

    <div class="card-header">
        <i class="bi bi-pencil-square me-2"></i>
        ویرایش رسید انبار
    </div>

    <div class="card-body">

        <form method="post">

            <input type="hidden"
                   asp-for="WarehouseReceipt.Id" />

            <!-- ========================= -->
            <!-- هدر رسید -->
            <!-- ========================= -->

            <div class="row g-3">

                <div class="col-md-3">

                    <label class="form-label">
                        شماره رسید
                    </label>

                    <input type="text" asp-for="WarehouseReceipt.ReceiptNumber" class="form-control" readonly />


                </div>


                <div class="col-md-3">

                    <label class="form-label">
                        تاریخ
                    </label>

                    <input asp-for="@Model.ShamsiDate" class="persian-date form-control" />
                </div>


                <div class="col-md-6">

                    <label class="form-label">
                        انبار
                    </label>

                    <select asp-for="WarehouseReceipt.WarehouseId"
                            asp-items="Model.WarehouseList"
                            class="form-select">

                        <option value="">
                            انتخاب کنید...
                        </option>

                    </select>

                </div>




                <div class="col-md-6">

                    <label class="form-label">
                        شماره درخواست خرید
                    </label>

                    <input asp-for="WarehouseReceipt.ReferenceNumber"
                           class="form-control" />

                </div>


                <div class="col-md-12">

                    <label class="form-label">
                        توضیحات
                    </label>

                    <textarea asp-for="WarehouseReceipt.Description"
                              class="form-control"></textarea>

                </div>

            </div>


            <hr />


            <!-- ========================= -->
            <!-- اقلام -->
            <!-- ========================= -->

            <h5 class="mb-3">
                اقلام رسید
            </h5>


            <div class="card">

                <div class="card-body p-0">

                    <table class="table table-bordered mb-0">

                        <thead>

                            <tr>

                                <th style="width:50px">
                                    #
                                </th>

                                <th>
                                    کالا
                                </th>

                                <th style="width:150px">
                                    تعداد
                                </th>

                                <th style="width:70px">
                                </th>

                            </tr>

                        </thead>


                        <tbody id="itemsBody">

                            @for (int i = 0; i < Model.Items.Count; i++)
                            {
                                <tr>

                                    <td class="row-number">
                                        @(i + 1)
                                    </td>


                                    <td>

                                        <select asp-for="Items[i].ProductId"
                                                class="form-select">

                                            <option value="">
                                                انتخاب کالا...
                                            </option>

                                            @foreach (var product in Model.Products)
                                            {
                                                <option value="@product.Id">
                                                    @product.ProductName
                                                </option>
                                            }

                                        </select>

                                    </td>


                                    <td>

                                        <input asp-for="Items[i].Quantity"
                                               type="number"
                                               min="1"
                                               class="form-control" />

                                    </td>


                                    <td>

                                        <button type="button"
                                                class="btn btn-danger btn-sm"
                                                onclick="removeRow(this)">

                                            ❌

                                        </button>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>


            <div class="mt-3">

                <button type="button"
                        id="btnAddItem"
                        class="btn btn-success">

                    <i class="bi bi-plus"></i>

                    افزودن کالا

                </button>

            </div>


            <hr />


            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-check-lg me-1"></i>

                    ذخیره تغییرات

                </button>


                <a asp-page="Details"
                   asp-route-id="@Model.WarehouseReceipt.Id"
                   class="btn btn-outline-secondary">

                    انصراف

                </a>

            </div>

        </form>

    </div>

</div>



























