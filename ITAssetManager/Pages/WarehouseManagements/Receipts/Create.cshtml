@page
@model ITAssetManager.Pages.WarehouseManagements.Receipts.CreateModel

@{
    ViewData["Title"] = "ایجاد رسید انبار";
}


<div class="card">
    <div class="card-header">ثبت رسید انبار</div>
    <div class="card-body">
        <form method="post">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">شماره رسید</label>
                    <input type="text" asp-for="@Model.ReceiptNumber" class="form-control" readonly />
                </div>
                <div class="col-md-3">
                    <span class="text-danger">*</span>
                    <label class="form-label"> تاریخ  </label>
                    <input asp-for="@Model.ShamsiDate" class="persian-date form-control" />
                </div>
                <div class="col-md-6">
                    <span class="text-danger">*</span>
                    <label class="form-label">انبار</label>                 
                    <select id="selectWarehouse"
                            asp-for="WarehouseReceipt.WarehouseId" asp-items="Model.WarehouseList" class="form-select">
                        <option value=""> انتخاب کنید...</option>
                    </select>
                </div>
               
                <div class="col-md-6">
                    <label class="form-label">شماره درخواست خرید</label>
                    <select asp-for="WarehouseReceipt.ReferenceNumber" asp-items="Model.PurchaseList" class="form-select">
                        <option value=""> انتخاب کنید...</option>
                    </select>
                </div>
                <div class="col-md-12">
                    <label class="form-label">توضیحات</label>
                    <textarea asp-for="WarehouseReceipt.Description"class="form-control"></textarea>
                </div>
            </div>
            <hr />
            <h5>اقلام رسید</h5>

            <div class="card mt-3">
                <div class="card-body p-0">
                    <table class="table table-bordered mb-0">
                        <thead>
                            <tr>
                                <th style="width:50px">#</th>
                                <th>کالا</th>
                                <th style="width:150px">تعداد</th>
                                <th style="width:70px"></th>
                            </tr>
                        </thead>
                        <tbody id="itemsBody">

                        </tbody>
                    </table>
                </div>
            </div>
            <div class="mt-3">
                <button type="button"
                        id="btnAddItem"
                        class="btn btn-success">
                    <i class="bi bi-plus"></i> افزودن کالا</button>
            </div>
            <hr />
            <div>
                <button class="btn btn-primary">ثبت رسید</button>
                <a asp-page="./Index" class="btn btn-secondary">
                    انصراف
                </a>
            </div>
        </form>
    </div>
</div>

<br />



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        
        const products = 
        [
            @foreach (var p in Model.Products)
            {
                <text>
                {
                    id:@p.Id,
                    name:"@p.ProductName"
                },

                </text>
            }
        ];
        
        document.getElementById('selectWarehouse')
          .addEventListener('change', async function () {
            const Id = this.value;
            console.log(Id);
           await fetch(`/WarehouseManagements/Receipts/Create?handler=SetKeeper&id=${Id}`);
          });
        
        
        let rowIndex = 0;
        document.getElementById("btnAddItem").addEventListener("click",addRow);

        function addRow()
        {
        const tbody=document.getElementById("itemsBody");
        const row=document.createElement("tr");
        row.innerHTML=
        `<td>${rowIndex+1} </td>
                <td>

        <select class="form-select" name="Items[${rowIndex}].ProductId">
         <option value="">انتخاب کالا...</option>
        ${
        products.map(x=>`

        <option value="${x.id}">

        ${x.name}

        </option>

        `).join("")
        }

        </select>

        </td>

        <td>

        <input
        type="number"
        min="1"
        value="1"
        class="form-control"
        name="Items[${rowIndex}].Quantity"/>

        <td>

        <button
        type="button"
        class="btn btn-danger btn-sm"
        onclick="removeRow(this)">

        ❌

        </button>

        </td>
        
        `;
        tbody.appendChild(row);
        rowIndex++;
        }


    </script>
}
