@page
@model ITAssetManager.Pages.WarehouseManagements.Keeper.CreateModel

@{
    ViewData["Title"] = "ثبت انباردار جدید";
}


<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-plus-circle me-2"></i>ثبت انباردار جدید
            </div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="row g-3 mb-3">

                    <div class="form-group ">
                        <span class="text-danger">*</span>
                        <label asp-for="WarehouseKeeper.FullName" class="control-label"></label>
                        <input asp-for="WarehouseKeeper.FullName" class="form-control" aria-required="true" />
                        <span asp-validation-for="WarehouseKeeper.FullName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="WarehouseKeeper.PersonnelNumber" class="control-label"></label>
                        <input asp-for="WarehouseKeeper.PersonnelNumber" class="form-control" />
                        <span asp-validation-for="WarehouseKeeper.PersonnelNumber" class="text-danger"></span>
                    </div>
                    </div>


                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>ذخیره
                        </button>
                        <a asp-page="Index" class="btn btn-outline-secondary">انصراف</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
               

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
