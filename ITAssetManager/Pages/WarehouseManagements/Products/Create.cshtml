@page
@model ITAssetManager.Pages.Products.CreateModel

@{
    ViewData["Title"] = " ثبت کالای جدید";
}

 <div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-plus-circle me-2"></i>ثبت کالای جدید
            </div>
            <div class="card-body">
               
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="row g-3 mb-3">
                        <div class="form-group">
                            <span class="text-danger">*</span>
                            <label asp-for="Product.ProductName" class="control-label"></label>
                            <input asp-for="Product.ProductName" class="form-control" aria-required="true" />
                            <span asp-validation-for="Product.ProductName" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Product.ProductDescription" class="control-label"></label>
                            <input asp-for="Product.ProductDescription" class="form-control" />
                            <span asp-validation-for="Product.ProductDescription" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Product.Model" class="control-label"></label>
                            <input asp-for="Product.Model" class="form-control" />
                            <span asp-validation-for="Product.Model" class="text-danger"></span>
                        </div>
                        <div class="form-group ">
                            <label asp-for="Product.CategoryId" class="control-label"></label>
                            <select asp-for="Product.CategoryId" class="form-control" asp-items="ViewBag.CategoryName"></select>
                        </div>
                    </div>
 
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>ذخیره
                        </button>
                        <a asp-page="Index" class="btn btn-outline-secondary">انصراف</a>
                    </div>
                </form>

            </div>
        </div>


    </div>
</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
