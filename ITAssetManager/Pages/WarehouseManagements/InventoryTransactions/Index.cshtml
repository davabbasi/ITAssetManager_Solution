@page
@using ITAssetManager.Convertor
@model ITAssetManager.Pages.WarehouseManagements.InventoryTransactions.IndexModel

@{
    ViewData["Title"] = "گردش کالا";
}

<!-- Filters -->
<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
           

            <div class="col-md-2">
                <select name="WarehouseId" class="form-select form-select-sm">
                    <option value="">همه انبارها</option>
                    @foreach (var warehouse in Model.WarehouseList)
                    {
                        <option value="@warehouse.Id" selected="@(Model.WarehouseId == warehouse.Id)">@warehouse.WarehouseName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="Type" class="form-select form-select-sm">
                    <option value="">همه تراکنش‌ها</option>
                    <option value="1" selected="@(Model.Type == 1)">رسید</option>
                    <option value="2" selected="@(Model.Type == 2)">حواله</option>
                    <option value="3" selected="@(Model.Type == 3)">انتقال به انبار</option>
                    <option value="4" selected="@(Model.Type == 4)">انتقال از انبار</option>
                    <option value="5" selected="@(Model.Type == 5)"> اصلاح موجودی (افزایش)</option>
                    <option value="6" selected="@(Model.Type == 6)"> اصلاح موجودی (کاهش)</option>
                </select>
            </div>

            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-primary btn-sm flex-fill">
                    <i class="bi bi-search"></i> جستجو
                </button>
                <a href="/WarehouseManagements/InventoryTransactions" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-x"></i>
                </a>
            </div>
        </form>
    </div>
</div>


<table class="table table-hover mb-0">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.InventoryTransaction[0].Quantity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InventoryTransaction[0].Type)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InventoryTransaction[0].TransactionDate)
            </th>
          
            <th>
                @Html.DisplayNameFor(model => model.InventoryTransaction[0].Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InventoryTransaction[0].CreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InventoryTransaction[0].CreatedBy)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InventoryTransaction[0].Warehouse)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InventoryTransaction[0].Product)
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.InventoryTransaction) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Quantity)
            </td>
            <td>
                    @item.Type.GetDisplayName()


            </td>
            <td>
                    @item.TransactionDate.ToShamsi()

            </td>
           
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                    @item.CreatedAt.ToShamsi()

            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedBy)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Warehouse.WarehouseName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Product.ProductName)
            </td>
          
        </tr>
}
    </tbody>
</table>
