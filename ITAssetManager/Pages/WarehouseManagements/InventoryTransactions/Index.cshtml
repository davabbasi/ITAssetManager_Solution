@page
@model ITAssetManager.Pages.WarehouseManagements.InventoryTransactions.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.InventoryTransaction[0].Quantity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InventoryTransaction[0].Type)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InventoryTransaction[0].TransactionDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InventoryTransaction[0].ReceiptItemId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InventoryTransaction[0].IssueItemId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InventoryTransaction[0].Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InventoryTransaction[0].CreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InventoryTransaction[0].CreatedBy)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InventoryTransaction[0].Warehouse)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InventoryTransaction[0].Product)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.InventoryTransaction) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Quantity)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Type)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TransactionDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ReceiptItemId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IssueItemId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedBy)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Warehouse.WarehouseName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Product.ProductName)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
