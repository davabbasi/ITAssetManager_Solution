@page
@model ITAssetManager.Pages.WarehouseManagements.WarehouseStocks.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>WarehouseStock</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="WarehouseStock.Id" />
            <div class="form-group">
                <label asp-for="WarehouseStock.WarehouseId" class="control-label"></label>
                <select asp-for="WarehouseStock.WarehouseId" class="form-control" asp-items="ViewBag.WarehouseId" ></select>
                <span asp-validation-for="WarehouseStock.WarehouseId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="WarehouseStock.ProductId" class="control-label"></label>
                <select asp-for="WarehouseStock.ProductId" class="form-control" asp-items="ViewBag.ProductId" ></select>
                <span asp-validation-for="WarehouseStock.ProductId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="WarehouseStock.Quantity" class="control-label"></label>
                <input asp-for="WarehouseStock.Quantity" class="form-control" />
                <span asp-validation-for="WarehouseStock.Quantity" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="WarehouseStock.UpdatedAt" class="control-label"></label>
                <input asp-for="WarehouseStock.UpdatedAt" class="form-control" />
                <span asp-validation-for="WarehouseStock.UpdatedAt" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
