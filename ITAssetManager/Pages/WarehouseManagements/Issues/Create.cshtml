@page
@model ITAssetManager.Pages.WarehouseManagements.Issues.CreateModel

@{
    ViewData["Title"] = "ثبت حواله";
}
@if (TempData["IssueDraftedSuccess"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["IssueDraftedSuccess"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["QuantityError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["QuantityError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}


<div class="card">

    <div class="card-header">

        ثبت حواله انبار

    </div>

    <div class="card-body">
        <form method="post">

            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">شماره حواله</label>
                    <input type="text" asp-for="IssueNumber" class="form-control" readonly />
                </div>

                <div class="col-md-3">
                    <label class="form-label"> تاریخ حواله  </label>
                    <input asp-for="@Model.ShamsiDate" class="persian-date form-control" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">انبار </label>
                    <select asp-for="WarehouseIssue.WarehouseId"
                            asp-items="Model.WarehouseList"
                            id="fromWarehouseSelect"
                            class="form-select">
                        <option value="">انتخاب کنید...</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">تحویل گیرنده</label>
                    <select asp-for="WarehouseIssue.EmployeeId" asp-items="Model.EmployeeList" class="form-select">
                        <option value="">انتخاب کنید...</option>
                    </select>
                </div>
               
                <div class="col-md-12">
                    <label class="form-label"> توضیحات</label>
                    <textarea asp-for="WarehouseIssue.Description"
                              class="form-control">
                    </textarea>
                </div>
            </div>

            <hr />

            <h5>
                اقلام حواله
            </h5>
            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>
            <div class="card mt-3">
                <div class="card-body p-0">
                    <table class="table table-bordered mb-0">
                        <thead>
                            <tr>
                                <th style="width:50px">#</th>
                                <th>کالا</th>
                                <th style="width:150px">تعداد</th>
                                <th style="width:70px">
                                </th>
                            </tr>
                        </thead>
                        <tbody id="itemsBody">

                            <tr id="emptyRow">
                                <td colspan="4" class="text-center text-muted py-3">
                                    ابتدا انبار را انتخاب کنید.
                                </td>
                            </tr>

                        </tbody>
                        
                    </table>
                </div>
            </div>
            <div class="mt-3">
                <button type="button"
                        id="btnAddItem"
                        class="btn btn-success">
                    <i class="bi bi-plus"></i>
                    افزودن کالا
                </button>
                
            </div>

            <hr />

            <button class="btn btn-primary">ثبت حواله</button>

        </form>
    </div>

</div>


<br />
<div>
    <a asp-page="./Index" class="btn btn-secondary">
        انصراف
    </a>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        let warehouseStocks = [];
        let rowIndex = 0;

        document
            .getElementById("fromWarehouseSelect")
            .addEventListener("change", async function () {

                const warehouseId = this.value;

                // اگر انبار انتخاب نشده
                if (!warehouseId) {

                    warehouseStocks = [];

                    document.getElementById("itemsBody").innerHTML = "";

                    return;
                }

                const response = await fetch(
                    `/WarehouseManagements/Issues/Create?handler=WarehouseStock&warehouseId=${warehouseId}`
                );

                if (!response.ok) {
                    alert("خطا در دریافت موجودی انبار");
                    return;
                }

                warehouseStocks = await response.json();

                // با تغییر انبار، اقلام قبلی پاک شوند
                document.getElementById("itemsBody").innerHTML = "";

                rowIndex = 0;
            });


        document
            .getElementById("btnAddItem")
            .addEventListener("click", addRow);


        function addRow() {

            if (warehouseStocks.length === 0) {

                alert("برای این انبار کالایی با موجودی موجود نیست.");

                return;
            }

            const tbody = document.getElementById("itemsBody");

            const row = document.createElement("tr");

            row.innerHTML = `
                <td>
                    ${rowIndex + 1}
                </td>

                <td>

                    <select
                        class="form-select"
                        name="Items[${rowIndex}].ProductId">

                        <option value="">
                            انتخاب کالا...
                        </option>

                        ${warehouseStocks.map(x => `
                            <option value="${x.productId}">
                                ${x.productName} - موجودی: ${x.quantity}
                            </option>
                        `).join("")}

                    </select>

                </td>

                <td>

                    <input
                        type="number"
                        min="1"
                        value="1"
                        class="form-control"
                        name="Items[${rowIndex}].Quantity" />

                </td>

                <td>

                    <button
                        type="button"
                        class="btn btn-danger btn-sm"
                        onclick="removeRow(this)">

                        ❌

                    </button>

                </td>
            `;

            tbody.appendChild(row);

            rowIndex++;
        }


        function removeRow(button) {

            button.closest("tr").remove();

        }

    </script>


}
