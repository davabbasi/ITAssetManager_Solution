@page "{id:int}"
@model ITAssetManager.Pages.WarehouseManagements.Issues.EditModel

@{
    ViewData["Title"] = "ویرایش حواله";
}


<div class="card">

    <div class="card-header">
        <i class="bi bi-pencil-square me-2"></i>
        ویرایش حواله انبار
    </div>

    <div class="card-body">

        <form method="post">

            <input type="hidden" asp-for="WarehouseIssue.Id" />

            <!-- ========================= -->
            <!-- هدر حواله -->
            <!-- ========================= -->

            <div class="row g-3">

                <div class="col-md-3">

                    <label class="form-label">
                        شماره حواله
                    </label>

                    <input type="text" asp-for="WarehouseIssue.IssueNumber" class="form-control" readonly />


                </div>


                <div class="col-md-3">

                    <label class="form-label">
                        تاریخ
                    </label>

                    <input asp-for="@Model.ShamsiDate" class="persian-date form-control" />
                </div>


                <div class="col-md-6">

                    <label class="form-label">
                        انبار
                    </label>

                    <select asp-for="WarehouseIssue.WarehouseId"
                            asp-items="Model.WarehouseList"
                            class="form-select">

                        <option value="">
                            انتخاب کنید...
                        </option>

                    </select>

                </div>

                <div class="col-md-4">
                    <label class="form-label">تحویل گیرنده</label>
                    <select asp-for="WarehouseIssue.EmployeeId" 
                      asp-items="Model.EmployeeList" 
                      class="form-select">
                      <option value="">
                        انتخاب کنید...
                      </option>
                    </select>
                </div>

                <div class="col-md-12">

                    <label class="form-label">
                        توضیحات
                    </label>

                    <textarea asp-for="WarehouseIssue.Description"
                              class="form-control"></textarea>

                </div>

            </div>


            <hr />


            <!-- ========================= -->
            <!-- اقلام -->
            <!-- ========================= -->

            <h5 class="mb-3">
                اقلام حواله
            </h5>

            <div class="card">

                <div class="card-body p-0">

                    <table class="table table-bordered mb-0">

                        <thead>

                            <tr>

                                <th style="width:50px">
                                    #
                                </th>

                                <th>
                                    کالا
                                </th>

                                <th style="width:150px">
                                    تعداد
                                </th>

                                <th style="width:70px">
                                </th>

                            </tr>

                        </thead>


                        <tbody id="itemsBody">

                            @for (int i = 0; i < Model.Items.Count; i++)
                            {
                                <tr>

                                    <td class="row-number">
                                        @(i + 1)
                                    </td>


                                    <td>

                                        <select asp-for="Items[i].ProductId"
                                                class="form-select">

                                            <option value="">
                                                انتخاب کالا...
                                            </option>

                                            @foreach (var product in Model.Products)
                                            {
                                                <option value="@product.Id">
                                                    @product.ProductName
                                                </option>
                                            }

                                        </select>

                                    </td>


                                    <td>

                                        <input asp-for="Items[i].Quantity"
                                               type="number"
                                               min="1"
                                               class="form-control" />

                                    </td>


                                    <td>

                                        <button type="button"
                                                class="btn btn-danger btn-sm"
                                                onclick="removeRow(this)">

                                            ❌

                                        </button>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>


            <div class="mt-3">

                <button type="button"
                        id="btnAddItem"
                        class="btn btn-success">

                    <i class="bi bi-plus"></i>

                    افزودن کالا

                </button>

            </div>


            <hr />


            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-check-lg me-1"></i>

                    ذخیره تغییرات

                </button>


                <a asp-page="Details"
                   asp-route-id="@Model.WarehouseIssue.Id"
                   class="btn btn-outline-secondary">

                    انصراف

                </a>

            </div>

        </form>

    </div>

</div>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        const products = [
            @foreach (var p in Model.Products)
            {
                        <text>
                        {
                            id: @p.Id,
                            name: "@p.ProductName"
                        },
                        </text>
            }
        ];


        let rowIndex = @Model.Items.Count;


        document
            .getElementById("btnAddItem")
            .addEventListener("click", addRow);


        function addRow()
        {
            const tbody = document.getElementById("itemsBody");

            const row = document.createElement("tr");

            row.innerHTML = `
                <td class="row-number"></td>

                <td>

                    <select
                        class="form-select"
                        name="Items[${rowIndex}].ProductId">

                        <option value="">
                            انتخاب کالا...
                        </option>

                        ${
                            products.map(x => `
                                <option value="${x.id}">
                                    ${x.name}
                                </option>
                            `).join("")
                        }

                    </select>

                </td>


                <td>

                    <input
                        type="number"
                        min="1"
                        value="1"
                        class="form-control"
                        name="Items[${rowIndex}].Quantity" />

                </td>


                <td>

                    <button
                        type="button"
                        class="btn btn-danger btn-sm"
                        onclick="removeRow(this)">

                        ❌

                    </button>

                </td>
            `;

            tbody.appendChild(row);

            rowIndex++;

            updateRowNumbers();
        }


        function removeRow(button)
        {
            button.closest("tr").remove();

            updateRowNumbers();
        }


        function updateRowNumbers()
        {
            const rows =
                document.querySelectorAll("#itemsBody tr");

            rows.forEach((row, index) =>
            {
                row.querySelector(".row-number").textContent =
                    index + 1;
            });
        }

    </script>
}