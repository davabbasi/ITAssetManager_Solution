@page
@model ITAssetManager.Pages.WarehouseManagements.Issues.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>WarehouseIssue</h4>
<hr />

<div class="card">

    <div class="card-header">

        ثبت رسید انبار

    </div>

    <div class="card-body">

        <form method="post">

            <div class="row g-3">

                <div class="col-md-3">

                    <label class="form-label">

                        شماره رسید

                    </label>

                    <input asp-for="WarehouseIssue.IssueNumber"
                           class="form-control" />

                </div>

                <div class="col-md-3">
                    <label class="form-label"> تاریخ  </label>
                    <input asp-for="@Model.ShamsiDate" class="persian-date form-control" />
                </div>

                <div class="col-md-6">

                    <label class="form-label">

                        انبار

                    </label>

                    <select asp-for="WarehouseIssue.FromWarehouseId" asp-items="Model.WarehouseList" class="form-select">
                        <option value=""> انتخاب کنید...</option>
                    </select>




                </div>

                <div class="col-md-6">

                    <label class="form-label">

                        انباردار

                    </label>



                </div>



                <div class="col-md-12">

                    <label class="form-label">

                        توضیحات

                    </label>

                    <textarea asp-for="WarehouseIssue.Description"
                              class="form-control">

                    </textarea>

                </div>

            </div>

            <hr />

            <h5>

                اقلام رسید

            </h5>

            <div class="card mt-3">

                <div class="card-body p-0">

                    <table class="table table-bordered mb-0">

                        <thead>

                            <tr>

                                <th style="width:50px">
                                    #
                                </th>

                                <th>
                                    کالا
                                </th>

                                <th style="width:150px">
                                    تعداد
                                </th>

                                <th style="width:70px">
                                </th>

                            </tr>

                        </thead>

                        <tbody id="itemsBody">
                        </tbody>

                    </table>

                </div>

            </div>

            <div class="mt-3">

                <button type="button"
                        id="btnAddItem"
                        class="btn btn-success">

                    <i class="bi bi-plus"></i>

                    افزودن کالا

                </button>

            </div>

            <hr />

            <button class="btn btn-primary">

                ثبت رسید

            </button>

        </form>

    </div>

</div>


























