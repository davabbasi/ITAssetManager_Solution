@page
@model ITAssetManager.Pages.WarehouseManagements.Issues.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>WarehouseIssue</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.WarehouseIssue.IssueNumber)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.WarehouseIssue.IssueNumber)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.WarehouseIssue.IssueDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.WarehouseIssue.IssueDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.WarehouseIssue.WarehouseId)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.WarehouseIssue.WarehouseId)
        </dd>
      
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.WarehouseIssue.CreatedBy)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.WarehouseIssue.CreatedBy)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.WarehouseIssue.CreatedAt)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.WarehouseIssue.CreatedAt)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.WarehouseIssue.Description)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.WarehouseIssue.Description)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.WarehouseIssue.Status)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.WarehouseIssue.Status)
        </dd>
    </dl>
</div>
<div class="card">

    <div class="card-header">

        اقلام رسید

    </div>

    <div class="card-body p-0">

        <table class="table table-bordered mb-0">

            <thead>

                <tr>

                    <th>#</th>

                    <th>کالا</th>

                    <th>تعداد</th>

                </tr>

            </thead>

            <tbody>

                @{
                    int row = 1;
                }

                @foreach (var item in Model.WarehouseIssue.Items)
                {
                    <tr>

                        <td>@row</td>

                        <td>@item.Product?.ProductName</td>

                        <td>@item.Quantity</td>

                    </tr>

                    row++;
                }

            </tbody>

        </table>

    </div>

</div>

<div>
    <a asp-page="./Edit" asp-route-id="@Model.WarehouseIssue.Id">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
