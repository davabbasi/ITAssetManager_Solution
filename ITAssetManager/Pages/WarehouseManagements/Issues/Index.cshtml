@page
@model ITAssetManager.Pages.WarehouseManagements.Issues.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.WarehouseIssue[0].IssueNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WarehouseIssue[0].IssueDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WarehouseIssue[0].FromWarehouseId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WarehouseIssue[0].ToWarehouseId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WarehouseIssue[0].CreatedBy)
            </th>        
            <th>
                @Html.DisplayNameFor(model => model.WarehouseIssue[0].Description)
            </th>
           
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.WarehouseIssue) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.IssueNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IssueDate)
            </td>
            <td>
                @(item.FromWarehouse?.WarehouseName ?? "-")
            </td>
            <td>
                @(item.ToWarehouse?.WarehouseName ?? "-")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedBy)
            </td>
           
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
          
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
