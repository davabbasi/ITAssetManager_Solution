@page
@using ITAssetManager.Convertor
@model ITAssetManager.Pages.WarehouseManagements.Issues.IndexModel

@{
    ViewData["Title"] = "لیست حواله ها";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <a asp-page="Create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>ثبت حواله جدید
    </a>

</div>

<!-- Filters -->
<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <input type="number" name="IssueNumber" value="@Model.IssueNumber"
                       class="form-control form-control-sm search-box"
                       placeholder="جستجو در شماره حواله..." />
            </div>
           

            <div class="col-md-2">
                <select name="WarehouseId" class="form-select form-select-sm">
                    <option value="">همه انبارها</option>
                    @foreach (var warehouse in Model.WarehouseList)
                    {
                        <option value="@warehouse.Id" selected="@(Model.WarehouseId == warehouse.Id)">@warehouse.WarehouseName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select form-select-sm">
                    <option value="">همه وضعیت‌ها</option>
                    <option value="1" selected="@(Model.Status == 1)">پیش‌ نویس</option>
                    <option value="2" selected="@(Model.Status == 2)">نهایی شده</option>
                    <option value="3" selected="@(Model.Status == 3)">ابطال شده</option>

                </select>
            </div>

            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-primary btn-sm flex-fill">
                    <i class="bi bi-search"></i> جستجو
                </button>
                <a href="/WarehouseManagements/Issues" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-x"></i>
                </a>
            </div>
        </form>
    </div>
</div>


<div class="table-responsive">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.WarehouseIssue[0].IssueNumber)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.WarehouseIssue[0].IssueDate)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.WarehouseIssue[0].WarehouseId)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.WarehouseIssue[0].EmployeeName)
                </th>

              
                <th>
                    @Html.DisplayNameFor(model => model.WarehouseIssue[0].CreatedBy)
                </th>

                <th>
                    @Html.DisplayNameFor(model => model.WarehouseIssue[0].Description)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.WarehouseIssue[0].Status)
                </th>
                <th>مشاهده</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.WarehouseIssue)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.IssueNumber)
                    </td>
                    <td>
                        @item.IssueDate.ToShamsi()
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Warehouse.WarehouseName)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.EmployeeName)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.CreatedBy)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.Description)
                    </td>
                    <td>
                        @if (item.Status == DocumentStatus.Draft)
                        {
                            <span class="badge bg-warning">
                                پیش نویس
                            </span>
                        }
                        @if (item.Status == DocumentStatus.Posted)
                        {
                            <span class="badge bg-success">
                                نهایی شده
                            </span>
                        }
                        @if (item.Status == DocumentStatus.Cancelled)
                        {
                            <span class="badge bg-danger">
                                ابطال شده
                            </span>
                        }
                    </td>
                    <td>

                        <div class="d-flex gap-1">
                            <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-xs btn-outline-secondary" title="مشاهده حواله">
                                <i class="bi bi-file-earmark-text"></i>
                            </a>
                        </div>

                    </td>
                </tr>
            }
        </tbody>
    </table>


</div>
