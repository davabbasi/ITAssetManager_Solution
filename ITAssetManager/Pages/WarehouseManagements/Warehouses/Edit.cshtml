@page
@model ITAssetManager.Pages.Warehouses.EditModel

@{
    ViewData["Title"] = "ویرایش انبار";
}


<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-pencil me-2"></i>ویرایش انبار
                <small class="text-muted me-2">— @Model.Warehouse.WarehouseName</small>
            </div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Warehouse.Id" />
                    <div class="form-group">
                        <span class="text-danger">*</span>
                        <label asp-for="Warehouse.WarehouseName" class="control-label"></label>
                        <input asp-for="Warehouse.WarehouseName" class="form-control" aria-required="true" />
                        <span asp-validation-for="Warehouse.WarehouseName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <span class="text-danger">*</span>
                        <label asp-for="Warehouse.KeeperId" class="control-label"></label>
                        <select asp-for="Warehouse.KeeperId" asp-items="Model.KeeperList" class="form-select">
                            <option value="0">انتخاب کنید...</option>
                        </select>
                        <span asp-validation-for="Warehouse.KeeperId" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Warehouse.Description" class="control-label"></label>
                        <input asp-for="Warehouse.Description" class="form-control" />
                        <span asp-validation-for="Warehouse.Description" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>ذخیره
                        </button>
                        <a asp-page="./Index" class="btn btn-outline-secondary">انصراف</a>
                    </div>
                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
