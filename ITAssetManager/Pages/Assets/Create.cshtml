@page
@model ITAssetManager.Pages.Assets.CreateModel
@{
    ViewData["Title"] = "ثبت تجهیز جدید";
}

@if (TempData["AssetWarehouseError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["AssetWarehouseError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}


@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-plus-circle me-2"></i>ثبت تجهیز جدید
            </div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>

                    <!-- بخش اول: اطلاعات اصلی -->
                    <h6 class=" text-muted mb-3 border-bottom pb-2 ">اطلاعات اصلی</h6>
                    <div class="row g-3 mb-3">

                        <div class="col-md-6">
                            <label class="form-label">نام تجهیز <span class="text-danger">*</span></label>
                            <input id="assetName" asp-for="Asset.Name" class="form-control" placeholder="مثلاً: لپ‌تاپ دل اداری" />
                            <span asp-validation-for="Asset.Name" class="text-danger small"></span>
                        </div>

                        <!-- انتخاب دسته بندی -->
                        <div class="col-md-6">
                            <label class="form-label">دسته‌بندی <span class="text-danger">*</span></label>
                            <select id="categorySelect" asp-for="Asset.CategoryId" asp-items="Model.CategoryList" class="form-select">
                                <option value="">انتخاب کنید...</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                انبار <span class="text-danger">*</span>
                            </label>

                            <select asp-for="WarehouseId"
                                    asp-items="Model.WarehouseList"
                                    id="warehouseSelect"
                                    class="form-select">
                                <option value="">انتخاب انبار...</option>
                            </select>

                            <span asp-validation-for="WarehouseId"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                کالا <span class="text-danger">*</span>
                            </label>

                            <select asp-for="ProductId"
                                    id="productSelect"
                                    class="form-select"
                                    disabled>
                                <option value="">ابتدا انبار را انتخاب کنید...</option>
                            </select>

                            <span asp-validation-for="ProductId"
                                  class="text-danger small"></span>

                            <div id="stockInfo"
                                 class="form-text text-success">
                            </div>
                        </div>


                      
                        <div class="col-md-4">
                            <label class="form-label">مدل</label>
                            <input asp-for="Asset.Model" class="form-control" placeholder="مدل دستگاه" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">وضعیت</label>
                            <select asp-for="Asset.Status" class="form-select">
                                <option value="1">فعال</option>
                                <option value="2">معیوب</option>
                                <option value="3">در تعمیر</option>
                                <option value="5">در انبار</option>
                            </select>
                        </div>
                    </div>
                    <br />
                    <!-- بخش پنجم: مشخصات و توضیحات -->
                    <h6 class="text-muted mb-3 border-bottom pb-2">مشخصات فنی</h6>
                    <div id="specs-container">

                        <!-- محل نمایش مشخصات فنی  -->

                    </div>
                    <br />

                    <!-- بخش دوم: شناسه‌ها -->
                    <h6 class="text-muted mb-3 border-bottom pb-2">شناسه‌ها</h6>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">
                                <i class="bi bi-tag me-1"></i>برچسب اموال
                                <span class="text-muted small">(واحد مالی)</span>
                            </label>
                            <input asp-for="Asset.PropertyTag" class="form-control" placeholder="AM-2024-001" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">سریال نامبر</label>
                            <input asp-for="Asset.SerialNumber" class="form-control" placeholder="S/N" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">بارکد</label>
                            <input asp-for="Asset.Barcode" class="form-control" placeholder="بارکد" />
                        </div>
                    </div>
                    <br />

                    <!-- بخش سوم: تاریخ‌ها -->
                    <h6 class="text-muted mb-3 border-bottom pb-2">تاریخ‌ها و مالی</h6>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">تاریخ خرید</label>

                            <input asp-for="TextPurchaseDate" type="text"
                                   id="purchaseDate"
                                   class="persian-date form-control"
                                   autocomplete="off"
                                   placeholder="انتخاب تاریخ" />

                          
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">انقضا گارانتی</label>

                            <input asp-for="TextWarrantyExpiryDate" type="text"
                                   id="warrantyExpiry"
                                   class="persian-date form-control"
                                   autocomplete="off"
                                   placeholder="انتخاب تاریخ" />

                        </div>
                        <div class="col-md-4">
                            <label class="form-label">قیمت خرید (تومان)</label>
                            <input asp-for="Asset.PurchasePrice" type="number" class="form-control" placeholder="0" />
                        </div>
                    </div>
                    <br />

                    <!-- بخش چهارم: تخصیص -->
                    <h6 class="text-muted mb-3 border-bottom pb-2">تخصیص</h6>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">فروشنده</label>
                            <select asp-for="Asset.VendorId" asp-items="Model.VendorList"
                                    id="vendorSelect" class="form-select">
                                <option value="">بدون فروشنده</option>
                            </select>
                        </div>                      
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>ذخیره
                        </button>
                        <a href="/Assets" class="btn btn-outline-secondary">انصراف</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        document.getElementById('categorySelect')
        .addEventListener('change', async function () {
            const categoryId = this.value;
            if (!categoryId) {
                document.getElementById('specs-container').innerHTML =
                    '<div class="text-muted">دسته‌بندی را انتخاب کنید</div>';
                return;
            }
            const response = await fetch(
                `/Assets/Create?handler=Specs&categoryId=${categoryId}`
            );
            const html = await response.text();
            document.getElementById('specs-container').innerHTML = html;
        });

        const warehouseSelect = document.getElementById('warehouseSelect');
        const productSelect = document.getElementById('productSelect');
        const stockInfo = document.getElementById('stockInfo');
        const assetName = document.getElementById('assetName');

        warehouseSelect.addEventListener('change', async function () {

            const warehouseId = this.value;

            productSelect.innerHTML =
                '<option value="">در حال بارگذاری...</option>';

            productSelect.disabled = true;

            stockInfo.innerHTML = '';

            if (!warehouseId) {

                productSelect.innerHTML =
                    '<option value="">ابتدا انبار را انتخاب کنید...</option>';

                return;
            }

            try {

                const response = await fetch(
                    `/Assets/Create?handler=WarehouseProducts&warehouseId=${warehouseId}`
                );

                if (!response.ok) {
                    throw new Error('خطا در دریافت کالاها');
                }

                const products = await response.json();

                productSelect.innerHTML =
                    '<option value="">انتخاب کالا...</option>';

                if (products.length === 0) {

                    productSelect.innerHTML =
                        '<option value="">کالایی با موجودی یافت نشد</option>';

                    return;
                }

                products.forEach(product => {

                    const option = document.createElement('option');

                    option.value = product.id;

                    option.textContent =
                        `${product.name} - موجودی: ${product.quantity}`;

                    option.dataset.quantity = product.quantity;

                    productSelect.appendChild(option);
                });

                productSelect.disabled = false;

            }
            catch (error) {

                productSelect.innerHTML =
                    '<option value="">خطا در دریافت کالاها</option>';

                console.error(error);
            }
        });

        productSelect.addEventListener('change',async function () {
            const productId = this.value;

            // اگر کالایی انتخاب نشده
            if (!productId) {
            stockInfo.innerHTML = '';
            document.getElementById('assetName').value = '';
            return;}
            // نمایش موجودی
            const selectedOption = this.options[this.selectedIndex];
            const quantity = selectedOption.dataset.quantity;
            stockInfo.innerHTML =`موجودی فعلی: <strong>${quantity}</strong> عدد`;

            // دریافت نام کالا
            try {
                const response = await fetch(
                `/Assets/Create?handler=ProductName&productId=${productId}`
                );

            if (!response.ok) {
                throw new Error('خطا در دریافت نام کالا');
            }

            const productName = await response.text();

            // پر کردن فیلد نام تجهیز
            document.getElementById('assetName').value = productName;
            } 
            catch (error) {
                console.error(error);
                document.getElementById('assetName').value = '';
            }
            });

        new TomSelect('#vendorSelect', {
            placeholder: 'جستجو در فروشندگان...',
            allowEmptyOption: true
        });
    </script>
}