@page "{id:int}"
@using ITAssetManager.Convertor
@model ITAssetManager.Pages.Assembly.DetailsModel
@{
    ViewData["Title"] = "سیستم #" + Model.PcAsset.AssemblyNumber;
}

@if (TempData["AssemblySuccess"] != null)
{
    <div class="alert alert-success alert-dismissible">
        @TempData["AssemblySuccess"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["AssemblyError"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        @TempData["AssemblyError"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <a href="/InternalComponents" class="text-muted text-decoration-none small">
            <i class="bi bi-arrow-right me-1"></i>لیست تجهیزات دارای قطعات داخلی
        </a>
        <h5 class="mb-0 mt-1 fw-bold">
            <span class="badge bg-primary">#@Model.PcAsset.AssemblyNumber</span>
            @Model.PcAsset.Name
        </h5>
    </div>
    <a href="/Assets/Details/@Model.PcAsset.Id" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-cpu me-1"></i>مشاهده به‌عنوان تجهیز
    </a>
</div>

<div class="row g-3">
    <div class="col-md-8">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <ul class="mb-0">
                    @foreach (var error in ViewData.ModelState.Values
                                    .SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }
        <!-- قطعات فعال -->
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between">
                <span><i class="bi bi-cpu-fill me-2"></i>قطعات نصب‌شده</span>
                <a href="/InternalComponents/AddComponent?pcId=@Model.PcAsset.Id" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-plus"></i> افزودن قطعه
                </a>
            </div>
            <div class="card-body p-0">
                @if (!Model.ActiveComponents.Any())
                {
                    <p class="text-muted text-center py-3">قطعه‌ای نصب نیست</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr><th>‌کد قطعه</th>
                                <th>دسته‌بندی</th>
                                <th>نام قطعه</th>
                                <th>کد یونیک</th>

                                <th>تاریخ نصب</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.ActiveComponents)
                            {
                                <tr>
                                    <td><small>@c.ComponentAsset?.Id</small></td>

                                    <td><small>@c.ComponentAsset?.Category?.Name</small></td>
                                    <td>
                                        <a href="/Assets/Details/@c.ComponentAssetId" class="text-decoration-none">
                                            @c.ComponentAsset?.Name
                                        </a>
                                    </td>
                                    <td><small>@(c.ComponentAsset?.Barcode ?? "-")</small></td>

                                    <td><small>@c.InstalledAt.ToShamsi()</small></td>
                                    <td>
                                        <form method="post" asp-page-handler="RemoveComponent"
                                              onsubmit="return confirm('این قطعه از سیستم خارج شود؟')">
                                            <input type="hidden" name="assemblyComponentId" value="@c.Id" />
                                            <button type="button"
                                                    class="btn btn-xs btn-outline-danger"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#removeComponentModal"
                                                    data-component-id="@c.Id"
                                                    data-component-name="@c.ComponentAsset?.Name">

                                                <i class="bi bi-box-arrow-up me-1"></i>
                                                خارج‌کردن
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <!-- تاریخچه قطعات (شامل خارج‌شده‌ها) -->
        @if (Model.RemovedComponents.Any())
        {
            <div class="card">
                <div class="card-header"><i class="bi bi-clock-history me-2"></i>تاریخچه قطعات خارج‌شده</div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr><th>کد قطعه</th><th>قطعه</th><th>تاریخ نصب</th><th>تاریخ خروج</th><th>توسط</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.RemovedComponents)
                            {
                                <tr class="text-muted">
                                    <td><small>@c.ComponentAsset.Id</small></td>

                                    <td><small>@c.ComponentAsset?.Name</small></td>
                                    <td><small>@c.InstalledAt.ToShamsi()</small></td>
                                    <td><small>@c.RemovedAt?.ToShamsi()</small></td>
                                    <td><small>@c.RemovedBy</small></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">اطلاعات تجهیز</div>
            <div class="card-body">
                <small class="text-muted d-block">شماره اموال</small>
                <span class="fw-medium d-block mb-2">@(Model.PcAsset.PropertyTag ?? "-")</span>

                <small class="text-muted d-block">مدل</small>
                <span class="d-block mb-2">@(Model.PcAsset.Model ?? "-")</span>

                <small class="text-muted d-block">تاریخ ایجاد</small>
                <span class="d-block mb-2">@Model.PcAsset.CreatedAt.ToShamsi()</span>

                @if (!string.IsNullOrEmpty(Model.PcAsset.Notes))
                {
                    <small class="text-muted d-block">توضیحات</small>
                    <span class="d-block">@Model.PcAsset.Notes</span>
                }
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="removeComponentModal"
     tabindex="-1" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <form method="post"
                  asp-page-handler="RemoveComponent">

                <div class="modal-header">
                    <h5 class="modal-title">خارج‌کردن قطعه از اسمبل</h5>

                    <button type="button"
                            class="btn-close ms-0"
                            data-bs-dismiss="modal"
                            aria-label="بستن">
                    </button>
                </div>

                <div class="modal-body">

                    <p>
                        قطعه:
                        <strong id="removeComponentName"></strong>
                    </p>

                    <input type="hidden"
                           id="removeComponentId"
                           name="assemblyComponentId" />

                    <label for="destinationWarehouseId"
                           class="form-label">
                        انبار مقصد
                    </label>

                    <select id="destinationWarehouseId"
                            name="destinationWarehouseId"
                            class="form-select"
                            asp-items="Model.AssetWarehouses"
                            required>
                        <option value="">انتخاب انبار...</option>
                    </select>

                    <input type="hidden"
                           name="id"
                           value="@Model.PcAsset.Id" />

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        انصراف
                    </button>

                    <button type="submit"
                            class="btn btn-danger">
                        تأیید خروج
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>



<style>
    .btn-xs {
        padding: 0.15rem 0.4rem;
        font-size: 0.75rem;
    }</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        const modal = document.getElementById('removeComponentModal');

        modal.addEventListener('show.bs.modal', function (event) {

            const button = event.relatedTarget;

            document.getElementById('removeComponentId').value =
                button.dataset.componentId;

            document.getElementById('removeComponentName').textContent =
                button.dataset.componentName || '';
        });

    });
</script>