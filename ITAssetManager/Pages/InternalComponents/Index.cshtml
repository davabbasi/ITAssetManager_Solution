@page
@using ITAssetManager.Convertor
@model ITAssetManager.Pages.Assembly.IndexModel
@{
    ViewData["Title"] = "اسمبل سیستم";
}


<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0 fw-bold">لیست تجهیزات دارای قطعات داخلی</h5>

    <a href="/InternalComponents/Create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>اسمبل سیستم جدید
    </a>

</div>

<!-- Filters -->
<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <input type="text" name="search" value="@Model.Search"
                       class="form-control form-control-sm search-box"
                       placeholder="جستجو در نام، سریال، بارکد، برچسب اموال..." />
            </div>
            <div class="col-md-2">
                <select name="categoryId" class="form-select form-select-sm">
                    <option value="">همه دسته‌ها</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id)">@cat.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select form-select-sm">
                    <option value="">همه وضعیت‌ها</option>
                    <option value="1" selected="@(Model.Status == 1)">فعال</option>
                    <option value="2" selected="@(Model.Status == 2)">معیوب</option>
                    <option value="3" selected="@(Model.Status == 3)">در تعمیر</option>
                    <option value="4" selected="@(Model.Status == 4)">اسقاط</option>
                    <option value="5" selected="@(Model.Status == 5)">انبار</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="departmentId" class="form-select form-select-sm">
                    <option value="">همه بخش‌ها</option>
                    @foreach (var dept in Model.Departments)
                    {
                        <option value="@dept.Id" selected="@(Model.DepartmentId == dept.Id)">@dept.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-primary btn-sm flex-fill">
                    <i class="bi bi-search"></i> جستجو
                </button>
                <a href="/InternalComponents" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-x"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header"><i class="bi bi-pc-display me-2"></i>@Model.Items.Count تجهیز</div>
    <div class="card-body p-0">
        @if (!Model.Items.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox fs-2"></i>
                <p class="mt-2">سیستمی اسمبل نشده</p>
            </div>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>شماره</th>
                        <th>تاریخ ایجاد</th>
                        <th>شماره اموال</th>
                        <th>مدل</th>
                        <th>تعداد قطعات فعال</th>
                        <th>تخصیص</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pc in Model.Assets)
                    {
                        <tr>
                            <td><span class="badge bg-primary">#@pc.AssemblyNumber</span></td>
                            <td><small>@pc.CreatedAt.ToShamsi()</small></td>
                            <td><small>@(pc.PropertyTag ?? "-")</small></td>
                            <td><small>@(pc.Name ?? "-")</small></td>
                            <td><span class="badge bg-light text-dark">@pc.Components.Count(c => c.RemovedAt == null) قطعه</span></td>
                            <td><small>@(pc.EmployeeName ?? pc.DepartmentName ?? "تخصیص‌نیافته")</small></td>
                            <td>
                                <a href="/InternalComponents/Details/@pc.Id" class="btn btn-xs btn-outline-secondary">
                                    <i class="bi bi-eye"></i> جزئیات
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<style>.btn-xs { padding: 0.15rem 0.4rem; font-size: 0.75rem; }</style>