@page
@using ITAssetManager.Convertor
@model ITAssetManager.Pages.Printers.CartridgeModel
@{
}
@{
    ViewData["Title"] = "مدیریت مصرف کارتریج";
}

<div class="container-fluid">

    <!-- عنوان صفحه -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">
                <i class="bi bi-printer me-2"></i>
                مدیریت مصرف کارتریج
            </h4>

            <small class="text-muted">
                ثبت و مشاهده سابقه مصرف کارتریج پرینتر
            </small>
        </div>

        <a asp-page="/Assets/Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-right me-1"></i>
            بازگشت
        </a>
    </div>


    <!-- مشخصات پرینتر -->
    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <i class="bi bi-printer me-2"></i>
            مشخصات پرینتر
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4 mb-3">
                    <div class="text-muted small">
                        نام تجهیز
                    </div>

                    <div class="fw-bold">
                        @Model.Printer.Name
                    </div>
                </div>


                <div class="col-md-4 mb-3">
                    <div class="text-muted small">
                        شماره اموال
                    </div>

                    <div class="fw-bold">
                        @Model.Printer.PropertyTag
                    </div>
                </div>


                <div class="col-md-4 mb-3">
                    <div class="text-muted small">
                        سریال
                    </div>

                    <div class="fw-bold">
                        @Model.Printer.SerialNumber
                    </div>
                </div>


                <div class="col-md-4">
                    <div class="text-muted small">
                        وضعیت
                    </div>

                    <div class="fw-bold">
                        @Model.Printer.Status
                    </div>
                </div>


                <div class="col-md-4">
                    <div class="text-muted small">
                        تحویل گیرنده
                    </div>

                    <div class="fw-bold">
                        @Model.Printer.EmployeeName
                    </div>
                </div>


                <div class="col-md-4">
                    <div class="text-muted small">
                        واحد
                    </div>

                    <div class="fw-bold">
                        @Model.Printer.DepartmentName
                    </div>
                </div>

            </div>

        </div>
    </div>


    <!-- سابقه مصرف -->
    <div class="card shadow-sm">

        <div class="card-header d-flex justify-content-between align-items-center">

            <span>
                <i class="bi bi-clock-history me-2"></i>
                سابقه مصرف کارتریج
            </span>

            <span class="badge bg-secondary">
                @Model.Consumptions.Count مورد
            </span>

        </div>


        <div class="card-body p-0">

            @if (Model.Consumptions.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover table-striped mb-0">

                        <thead>
                            <tr>
                                <th>ردیف</th>
                                <th>کارتریج</th>
                                <th>تعداد</th>
                                <th>تاریخ مصرف</th>
                                <th>ثبت کننده</th>
                                <th>توضیحات</th>
                            </tr>
                        </thead>

                        <tbody>

                            @{
                                int row = 1;
                            }

                            @foreach (var item in Model.Consumptions)
                            {
                                <tr>

                                    <td>
                                        @row
                                    </td>

                                    <td>
                                        @item.Product?.ProductName
                                    </td>

                                    <td>
                                        @item.Quantity
                                    </td>

                                    <td>
                                        @item.ConsumptionDate.ToShamsi()
                                    </td>

                                    <td>
                                        @item.CreatedBy
                                    </td>

                                    <td>
                                        @item.Description
                                    </td>

                                </tr>

                                row++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center text-muted py-5">

                    <i class="bi bi-inbox fs-1 d-block mb-3"></i>

                    <div>
                        تاکنون مصرف کارتریجی برای این پرینتر ثبت نشده است.
                    </div>

                </div>
            }

        </div>

    </div>

</div>