@page
@using ITAssetManager.Convertor
@model ITAssetManager.Pages.Printers.CartridgeModel
@{
}
@{
    ViewData["Title"] = "مدیریت مصرف کارتریج";
}

<div class="container-fluid">

    @if (TempData["CartridgeSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["CartridgeSuccess"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <!-- عنوان صفحه -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">
                <i class="bi bi-printer me-2"></i>
                مدیریت مصرف کارتریج
            </h4>

            <small class="text-muted">
                ثبت و مشاهده سابقه مصرف کارتریج پرینتر
            </small>
        </div>

        <a asp-page="/Printers/Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-right me-1"></i>
            بازگشت
        </a>
    </div>

    <!-- مشخصات پرینتر -->
    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <i class="bi bi-printer me-2"></i>
            مشخصات پرینتر
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4 mb-3">
                    <div class="text-muted small">
                        نام تجهیز
                    </div>

                    <div class="fw-bold">
                        @Model.Printer.Name
                    </div>
                </div>


                <div class="col-md-4 mb-3">
                    <div class="text-muted small">
                        شماره اموال
                    </div>

                    <div class="fw-bold">
                        @Model.Printer.PropertyTag
                    </div>
                </div>


                <div class="col-md-4 mb-3">
                    <div class="text-muted small">
                        سریال
                    </div>

                    <div class="fw-bold">
                        @Model.Printer.SerialNumber
                    </div>
                </div>


                <div class="col-md-4">
                    <div class="text-muted small">
                        وضعیت
                    </div>

                    <div class="fw-bold">
                        @Model.Printer.Status.GetDisplayName()
                    </div>
                </div>


                <div class="col-md-4">
                    <div class="text-muted small">
                        تحویل گیرنده
                    </div>

                    <div class="fw-bold">
                        @Model.Printer.EmployeeName
                    </div>
                </div>


                <div class="col-md-4">
                    <div class="text-muted small">
                        واحد
                    </div>

                    <div class="fw-bold">
                        @Model.Printer.DepartmentName
                    </div>
                </div>


                <div class="col-md-4">
                    <div class="text-muted small">
                        توضیحات
                    </div>

                    <div class="fw-bold">
                        @Model.Printer.Notes
                    </div>
                </div>

            </div>

        </div>
    </div>

    <!-- ثبت مصرف کارتریج -->
    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <i class="bi bi-plus-circle me-2"></i>
            ثبت مصرف کارتریج
        </div>

        <div class="card-body">

            <form method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row">

                    <!--انبار-->
                    <div class="col-md-4 mb-3">
                        <label class="form-label">انبار </label>
                        <select asp-for="WarehouseIssue.WarehouseId"
                                asp-items="Model.WarehouseList"
                                id="fromWarehouseSelect"
                                class="form-select">
                            <option value="">انتخاب کنید...</option>
                        </select>
                    </div>

                    <!-- کارتریج -->
                    <div class="col-md-4 mb-3">

                        <label asp-for="ProductId"
                               class="form-label">
                            کارتریج
                        </label>

                        <select asp-for="ProductId"
                                id="cartridgeSelect"
                                class="form-select">

                            <option value="">
                                انتخاب کارتریج...
                            </option>

                        </select>

                        <span asp-validation-for="ProductId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- تعداد -->
                    <div class="col-md-2 mb-3">

                        <label asp-for="Quantity"
                               class="form-label">
                            تعداد
                        </label>

                        <input asp-for="Quantity"
                               type="number"
                               min="1"
                               class="form-control" />

                        <span asp-validation-for="Quantity"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- تاریخ مصرف -->
                    <div class="col-md-3 mb-3">

                        <label asp-for="ConsumptionShamsiDate"
                               class="form-label">
                            تاریخ مصرف
                        </label>

                        <input asp-for="ConsumptionShamsiDate"
                               class="form-control"
                               placeholder="1405/01/01"
                               autocomplete="off" />

                        <span asp-validation-for="ConsumptionShamsiDate"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- توضیحات -->
                    <div class="col-md-3 mb-3">

                        <label asp-for="Description"
                               class="form-label">
                            توضیحات
                        </label>

                        <input asp-for="Description"
                               class="form-control"
                               placeholder="اختیاری" />

                    </div>

                </div>


                <div class="d-flex justify-content-end">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check2-circle me-1"></i>

                        ثبت مصرف

                    </button>

                </div>

            </form>

        </div>

    </div>

    <!-- سابقه مصرف -->
    <div class="card shadow-sm">

        <div class="card-header d-flex justify-content-between align-items-center">

            <span>
                <i class="bi bi-clock-history me-2"></i>
                سابقه مصرف کارتریج
            </span>

            <span class="badge bg-secondary">
                @Model.Consumptions.Count مورد
            </span>

        </div>


        <div class="card-body p-0">

            @if (Model.Consumptions.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover table-striped mb-0">

                        <thead>
                            <tr>
                                <th>ردیف</th>
                                <th>کارتریج</th>
                                <th>تعداد</th>
                                <th>تاریخ مصرف</th>
                                <th>ثبت کننده</th>
                                <th>توضیحات</th>
                            </tr>
                        </thead>

                        <tbody>

                            @{
                                int row = 1;
                            }

                            @foreach (var item in Model.Consumptions)
                            {
                                <tr>

                                    <td>
                                        @row
                                    </td>

                                    <td>
                                        @item.Product?.ProductName
                                    </td>

                                    <td>
                                        @item.Quantity
                                    </td>

                                    <td>
                                        @item.ConsumptionDate.ToShamsi()
                                    </td>

                                    <td>
                                        @item.CreatedBy
                                    </td>

                                    <td>
                                        @item.Description
                                    </td>

                                </tr>

                                row++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center text-muted py-5">

                    <i class="bi bi-inbox fs-1 d-block mb-3"></i>

                    <div>
                        تاکنون مصرف کارتریجی برای این پرینتر ثبت نشده است.
                    </div>

                </div>
            }

        </div>

    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        let warehouseStocks = [];

        const warehouseSelect =
            document.getElementById("fromWarehouseSelect");

        const cartridgeSelect =
            document.getElementById("cartridgeSelect");


        warehouseSelect.addEventListener("change", async function () {

            const warehouseId = this.value;


            // -----------------------------
            // اگر انبار انتخاب نشده
            // -----------------------------

            if (!warehouseId) {

                warehouseStocks = [];

                cartridgeSelect.innerHTML = `
                    <option value="">
                        انتخاب کارتریج...
                    </option>
                `;

                return;
            }


            // -----------------------------
            // دریافت موجودی کارتریج‌های انبار
            // -----------------------------

            try {

                const response = await fetch(
                    `/Printers/Cartridge?handler=WarehouseStock&warehouseId=${warehouseId}`
                );


                if (!response.ok) {

                    alert("خطا در دریافت موجودی انبار");
                    return;
                }


                warehouseStocks = await response.json();


                console.log("Warehouse:", warehouseId);
                console.log("Cartridge Stocks:", warehouseStocks);


                // -----------------------------
                // پاک کردن لیست قبلی
                // -----------------------------

                cartridgeSelect.innerHTML = `
                    <option value="">
                        انتخاب کارتریج...
                    </option>
                `;


                // -----------------------------
                // اضافه کردن کارتریج‌های جدید
                // -----------------------------

                warehouseStocks.forEach(item => {

                    const option =
                        document.createElement("option");


                    option.value = item.productId;


                    option.textContent =
                        `${item.productName} - موجودی: ${item.quantity}`;


                    cartridgeSelect.appendChild(option);

                });

            }
            catch (error) {

                console.error(
                    "خطا در دریافت کارتریج‌ها:",
                    error
                );

                alert("خطایی در دریافت کارتریج‌ها رخ داد.");

            }

        });

    });
</script>


