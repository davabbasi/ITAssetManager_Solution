@page
@using ITAssetManager.Convertor
@model ITAssetManager.Pages.Printers.IndexModel
@{
}


<!-- Filters -->
<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <input type="text" name="search" value="@Model.Search"
                       class="form-control form-control-sm search-box"
                       placeholder="جستجو در نام، سریال، بارکد، برچسب اموال..." />
            </div>

            <div class="col-md-2">

                <select name="status" class="form-select form-select-sm">
                    <option value="">همه وضعیت‌ها</option>
                    <option value="3" selected="@(Model.Status == 3)">در دست تعمیر</option>
                    <option value="4" selected="@(Model.Status == 4)">اسقاط</option>
                    <option value="5" selected="@(Model.Status == 5)">در انبار تجهیزات</option>
                    <option value="6" selected="@(Model.Status == 6)">ضایعات</option>
                    <option value="7" selected="@(Model.Status == 7)">اسمبل شده</option>
                    <option value="8" selected="@(Model.Status == 8)">تخصیص یافته</option>
                </select>


            </div>
            <div class="col-md-2">
                <select name="departmentId" class="form-select form-select-sm">
                    <option value="">همه واحد‌ها</option>
                    @foreach (var dept in Model.Departments)
                    {
                        <option value="@dept.Id" selected="@(Model.DepartmentId == dept.Id)">@dept.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="employeeId" class="form-select form-select-sm">
                    <option value="">همه پرسنل</option>
                    @foreach (var em in Model.Employees)
                    {
                        <option value="@em.Id" selected="@(Model.EmployeeId == em.Id)">@em.FullName</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-primary btn-sm flex-fill">
                    <i class="bi bi-search"></i> جستجو
                </button>
                <a href="/Assets" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-x"></i>
                </a>


            </div>

        </form>
    </div>
</div>

<!-- Results -->
<div class="card">

    @* <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-table me-2"></i>@Model.TotalCount تجهیز</span>
        <a asp-page-handler="Pdf"
           asp-route-search="@Model.Search"
           asp-route-categoryId="@Model.CategoryId"
           asp-route-status="@Model.Status"
           asp-route-departmentId="@Model.DepartmentId"
           asp-route-employeeId="@Model.EmployeeId"
           class="btn btn-danger">

            <i class="bi bi-file-earmark-pdf"></i>
            PDF
        </a>
    </div> *@

    <div class="card-body p-0">
        @if (!Model.Assets.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox" style="font-size:2.5rem;"></i>
                <p class="mt-2">تجهیزی یافت نشد</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>کد تجهیز </th>
                            <th>برچسب اموال</th>
                            <th>نام / مدل</th>
                            <th>واحد</th>
                            <th>پرسنل</th>
                            <th>وضعیت</th>
                            <th>اسمبل شده در</th>
                            <th>مکان قرار گیری</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var asset in Model.Assets)
                        {

                            <tr>
                                <td>@(asset.Id)</td>


                                <td class="fw-medium" style="font-size:0.82rem;">
                                    @(asset.PropertyTag ?? "-")
                                </td>
                                <td>
                                    <a href="/Assets/Details/@asset.Id" class="text-decoration-none fw-medium">
                                        @asset.Name
                                    </a>

                                </td>
                            

                                <td>
                                    @if (asset.DepartmentName != null)
                                    {
                                        <small>@asset.DepartmentName</small>
                                    }
                                    else
                                    {
                                        <small class="text-muted">‌-</small>
                                    }
                                </td>
                                <td>
                                    @if (asset.EmployeeName != null)
                                    {
                                        <small>@asset.EmployeeName</small>
                                    }

                                    else
                                    {
                                        <small class="text-muted">-</small>
                                    }
                                </td>
                                <td>
                                    @{
                                        var (bc, lbl) = asset.Status switch
                                        {
                                            AssetStatus.Active => ("badge-active", "فعال"),
                                            AssetStatus.Faulty => ("badge-faulty", "معیوب"),
                                            AssetStatus.UnderRepair => ("badge-repair", "دردست تعمیر"),
                                            AssetStatus.Scrapped => ("badge-scrapped", "اسقاط"),
                                            AssetStatus.Assigned => ("badge-assigned", "تخصیص یافته"),
                                            AssetStatus.Installed => ("badge-installed", "اسمبل شده"),

                                            _ => ("badge-storage", "در انبار تجهیزات")
                                        };
                                    }
                                    <span class="badge @bc">@lbl</span>
                                </td>
                                <td>
                                    @if (Model.ComponentLocations.TryGetValue(asset.Id, out var location))
                                    {
                                        <span class="badge bg-info">
                                            <i class="bi bi-pc-display me-1"></i>
                                            : @location
                                        </span>
                                    }
                                    else if (asset.Category?.Type == AssetCategoryType.Installed)
                                    {
                                        <span class="text-muted small">
                                            آزاد
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td>@(asset.Location ?? "-")</td>
                                <td>
                                    <div class="d-flex gap-1">
                                       
                                        <a asp-page="/Printers/Cartridge"
                                           asp-route-id="@asset.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-printer me-1"></i>
                                            مدیریت کارتریج
                                        </a>

                                    </div>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<style>
    .btn-xs {
        padding: 0.15rem 0.4rem;
        font-size: 0.75rem;
    }
</style>
